# Local MongoDB or your MongoDB Atlas connection string (keep this private).
# If omitted, `npm run dev` starts a real local MongoDB with data in .local-data/.
# Production requires an explicit MONGODB_URI.
# MONGODB_URI=mongodb://127.0.0.1:27017/poetryverse
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-this-with-a-random-secret-at-least-32-characters
PORT=3001
# Set these only on your HTTPS production host:
# NODE_ENV=production
# TRUST_PROXY=1
